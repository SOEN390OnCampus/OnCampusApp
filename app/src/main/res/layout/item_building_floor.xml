<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <!-- Building Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Circle thing with building id -->
        <TextView
            android:layout_margin="10dp"
            android:id="@+id/tv_building_id"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/concordia_red"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="MB"/>

        <TextView
            android:id="@+id/tv_building_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Main Building"/>
        <ImageView
            android:id="@+id/iv_dropdown"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_drop_down"/>

    </LinearLayout>
    <LinearLayout
        android:layout_margin="10dp"
        android:id="@+id/floor_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="visible"
        android:background="@drawable/bg_floor_selection">

        <TextView
            android:layout_margin="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_floor"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <!-- The floor selection -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_floors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

    </LinearLayout>

</LinearLayout>