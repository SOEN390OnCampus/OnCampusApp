<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/account_card_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/googleg_standard_color_18"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect with Google"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CalendarSync wants access to your Google Account to retrieve your calendar list."
        android:textSize="14sp"
        android:textColor="#444444"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/account_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/account_card_border"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/txt_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="TE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/avatar_background"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temp Encs"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txt_account_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="temp.encs@live.concordia.ca"
                android:textColor="#666666"
                android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="By continuing, Google will share your name, email address, and calendar data with CalendarSync."
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@android:color/transparent"
            app:strokeColor="#CCCCCC"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_allow"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Allow"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7A1C1C"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</LinearLayout>